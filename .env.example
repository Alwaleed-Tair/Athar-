# Copy this file to backend/.env (or export these as real environment
# variables before starting uvicorn) and fill in real values.
# Never commit a real .env file -- it is already listed in .gitignore.

# Secret used to sign JWT session tokens. Required for sessions to survive
# a server restart. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
ATHAR_JWT_SECRET=

# How long a login session stays valid, in minutes.
ATHAR_JWT_EXPIRE_MINUTES=480

# Optional: enables the "AI analysis" feature on the Evidence screen
# (cross-evidence correlation: same device, same hash, time proximity,
# conflicting timestamps). If left empty, that feature is disabled and
# the UI shows a clear "disabled" message instead of any result.
ATHAR_AI_KEY=
ATHAR_AI_URL=https://api.deepseek.com/chat/completions
ATHAR_AI_MODEL=deepseek-chat

# Bootstrap ADMIN account, created automatically only if the users table
# is empty on first run. Change the password after first login.
ATHAR_ADMIN_USERNAME=admin
ATHAR_ADMIN_PASSWORD=ChangeMe123!

# Max upload size for a single evidence file, in megabytes.
ATHAR_MAX_UPLOAD_MB=50

# --- v13 additions -----------------------------------------------------
# ATHAR does not send e-mail. New self-registered accounts are approved by an administrator
# (Users screen); the contact form stores messages for administrators.

# Deleted evidence files are kept this many days, then permanently removed.
ATHAR_EVIDENCE_RETENTION_DAYS=30
# Sign-in throttling.
ATHAR_LOGIN_MAX_FAILURES=5
ATHAR_LOGIN_LOCK_SECONDS=900

# Optional search by meaning (any OpenAI-compatible /embeddings endpoint). Disabled when empty.
ATHAR_EMBED_KEY=
ATHAR_EMBED_URL=https://api.openai.com/v1/embeddings
ATHAR_EMBED_MODEL=text-embedding-3-small
# OCR: uses local Tesseract if installed (languages below), else the AI vision model.
ATHAR_OCR_LANGS=ara+eng

# Image features (OCR, image descriptions, authenticity) need a VISION-capable model.
# If your text provider has none, point images at another OpenAI-compatible provider.
# Leave empty to reuse ATHAR_AI_URL / ATHAR_AI_KEY.
ATHAR_VISION_URL=
ATHAR_VISION_KEY=
ATHAR_AI_VISION_MODEL=deepseek-v4-flash-vision-exp

# Restricted cross-case notices (match with a case you are not a member of; details hidden,
# owner decides on access requests). 1 = on (default), 0 = off.
ATHAR_RESTRICTED_LINK_ALERTS=1
