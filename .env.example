# Copy this file to backend/.env (or export these as real environment
# variables before starting uvicorn) and fill in real values.
# Never commit a real .env file -- it is already listed in .gitignore.

# Secret used to sign JWT session tokens. Required for sessions to survive
# a server restart. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
ATHAR_JWT_SECRET=

# How long a login session stays valid, in minutes.
ATHAR_JWT_EXPIRE_MINUTES=480

# Optional: enables the "AI analysis" feature on the Evidence screen
# (cross-evidence correlation: same device, same hash, time proximity,
# conflicting timestamps). If left empty, that feature is disabled and
# the UI shows a clear "disabled" message instead of any result.
ATHAR_AI_KEY=
ATHAR_AI_URL=https://api.anthropic.com/v1/messages

# Bootstrap ADMIN account, created automatically only if the users table
# is empty on first run. Change the password after first login.
ATHAR_ADMIN_USERNAME=admin
ATHAR_ADMIN_PASSWORD=ChangeMe123!

# Max upload size for a single evidence file, in megabytes.
ATHAR_MAX_UPLOAD_MB=50
